# -----------------------------------------------------------------------------
# Google DevFest KL 2026 PWA - Environment Variables
# Copy this file to `.env.local` or `.env` and fill in your actual credentials.
# -----------------------------------------------------------------------------

# Supabase Credentials (Get these from your Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Integration Flag
# Set to 'true' to query live Supabase database tables; 'false' to use local mock data
VITE_USE_REMOTE_BACKEND=false

# (Optional) Custom Node.js Middleware Endpoint if using a custom server
VITE_NODE_MIDDLEWARE_URL=http://localhost:4000/api
